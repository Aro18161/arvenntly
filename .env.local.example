# ---- Upstash Redis ----
# Vercel: Storage 탭에서 Upstash Redis를 프로젝트에 연결하면 자동으로 주입됩니다.
# 로컬: console.upstash.com 에서 DB 생성 후 REST URL/TOKEN을 복사해 넣으세요.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- 관리자 비밀번호 ----
# 링크 생성 페이지에 접근할 때 입력하는 비밀번호입니다.
ADMIN_PASSWORD=

# ---- 선택 ----
# 세션 쿠키 서명 키. 비워두면 ADMIN_PASSWORD로 서명합니다.
# AUTH_SECRET=

# 자기 자신을 단축해서 무한 리다이렉트가 생기는 걸 막습니다.
# NEXT_PUBLIC_SITE_HOST=arvenne.com

# 랜덤 슬러그를 섞지 않고 10, 11, 12... 순서대로 발급하려면 off
# SLUG_SCRAMBLE=off
